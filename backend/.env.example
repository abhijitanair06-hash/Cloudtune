# Copy this file to .env from the backend directory.
# Generate two DIFFERENT secrets locally; never commit the generated values:
# python -c "import secrets; print(secrets.token_urlsafe(48))"

DATABASE_URL=postgresql+asyncpg://cloudtune:replace-with-strong-password@localhost:5432/cloudtune
JWT_SECRET_KEY=replace-with-a-random-secret-generated-locally
JWT_REFRESH_SECRET_KEY=replace-with-a-different-random-secret-generated-locally
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=music

# Used by infrastructure/docker-compose.yml; keep it in sync with DATABASE_URL.
POSTGRES_PASSWORD=replace-with-strong-password
