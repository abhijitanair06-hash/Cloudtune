SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=music

# Generate a fresh local key with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
# Put the generated value in backend/.env. Never commit backend/.env.
JWT_SECRET_KEY=

# Comma-separated exact browser origins. Set production site origin before deploy.
ENVIRONMENT=development
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# CloudTune storage meter (Supabase Free quota currently 1 GB total across buckets/projects in an organization).
# This app accounts for media indexed by CloudTune; orphaned objects and unrelated buckets need provider-side review.
STORAGE_QUOTA_BYTES=1000000000
STORAGE_UPLOAD_BLOCK_RATIO=0.95
