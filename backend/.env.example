# Create backend/.env locally and fill in every value.
# Generate a private signing key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-unique-64-character-hex-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15

DATABASE_URL=postgresql+asyncpg://cloudtune:CHANGE_ME@localhost:5432/cloudtune

SUPABASE_URL=
